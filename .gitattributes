# Normalize line endings for text; never touch the vendored WinFsp SDK blobs
# (headers/libs/dlls under vendor/) — EOL mangling there breaks builds.
* text=auto
vendor/winfsp-sys/winfsp/** -text
# The kernel tree is built and run on Linux only; CRLF would break the
# shebangs and the Kbuild files even when checked out on Windows.
kernel/** text eol=lf
scripts/*.sh text eol=lf
scripts/*.service text eol=lf
# Installed verbatim onto Linux systems (shell, dkms.conf, udev rules,
# systemd units): CRLF would break shebangs and udev rule parsing.
packaging/** text eol=lf
# Served as-is by GitHub Pages. CNAME in particular is parsed as a single
# hostname and a trailing CR would make it a different (invalid) one.
docs/** text eol=lf
# ...except batch files, which cmd.exe parses rather than a browser. A .cmd
# with LF endings makes `goto` fail to find its labels — "The system cannot
# find the batch label specified", measured rather than theorised — and
# install.cmd is downloaded verbatim by `curl -o install.cmd` and run. This
# rule comes after the docs/** line deliberately: the last match wins.
docs/*.cmd text eol=crlf
